// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Person {
  id        Int        @id @default(autoincrement())
  firstName String
  lastName  String
  nickname  String?
  role      PersonRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  notes     String     @default("") @db.VarChar(200)
  schoolId String?   @unique

  loans         Loan[]
  returnedItems LoanedItem[]
  tags          Tag[]

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt

  roleId Int

  @@unique([firstName, lastName, nickname])
}

model PersonRole {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String @default("") @db.VarChar(50)
  color       String @default("#000000") @db.VarChar(7)

  people Person[]

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
}

model Item {
  id          Int     @id @default(autoincrement())
  uuid        String  @unique
  name        String  @unique
  description String? @db.VarChar(50)
  notes       String? @db.VarChar(200)

  location Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  type     ItemType    @relation(fields: [typeId], references: [id], onDelete: Restrict)

  tags  Tag[]
  loans LoanedItem[]

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt

  locationId Int
  typeId     Int
}

model ItemType {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String @default("") @db.VarChar(50)

  items Item[]

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
}

model Location {
  id   Int    @id @default(autoincrement())
  name String @unique

  items Item[]

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
}

model Loan {
  id     Int          @id @default(autoincrement())
  person Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  items  LoanedItem[]
  notes  String       @default("") @db.VarChar(200)
  tags   Tag[]

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt

  personId Int
}

model LoanedItem {
  loan         Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  item         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  dateLoaned   DateTime  @default(now())
  dateReturned DateTime?
  status   String     @default("out") @db.VarChar(50)

  returnedBy Person? @relation(fields: [returnedById], references: [id], onDelete: SetNull)

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt

  loanId       Int
  itemId       Int
  returnedById Int?

  @@id([loanId, itemId])
}

model Tag {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.VarChar(50)
  color       String
  priority    Int     @default(0)
  category    String
  // TODO - add a way to restrict tags to certain models
  //   allowedEntries  String @default("all")
  hidden      Boolean @default(false)

  loans  Loan[]
  items  Item[]
  people Person[]

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt

  @@unique([name, category])
}

model Migration {
  id               Int      @id @default(autoincrement())
  type             String   @default("grade_promotion")
  status           String   @default("completed")
  changes          String   @db.LongText
  studentsAffected Int      @default(0)
  movedToAlumni    Int      @default(0)
  promoted         Int      @default(0)
  academicYear     String?
  notes            String?  @db.VarChar(500)
  createdDate      DateTime @default(now())
  updatedDate      DateTime @updatedAt
}
